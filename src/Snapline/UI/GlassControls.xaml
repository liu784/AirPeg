<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ChromeFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border Margin="-3" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource ChromeAccent}"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="Background" Value="{DynamicResource ChromeControl}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ChromeEdge}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,7"/><Setter Property="MinHeight" Value="30"/><Setter Property="FocusVisualStyle" Value="{StaticResource ChromeFocus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Border CornerRadius="9" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ChromeShine}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ChromeHover}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ChromeAccent}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ChromePressed}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ChromeToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="Padding" Value="7"/><Setter Property="FocusVisualStyle" Value="{StaticResource ChromeFocus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Padding="{TemplateBinding Padding}" CornerRadius="8" Background="{DynamicResource ChromeControl}" BorderThickness="1" BorderBrush="{DynamicResource ChromeEdge}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ChromeHover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ChromeSelected}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ChromeAccent}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ChromePressed}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="MinHeight" Value="30"/><Setter Property="FocusVisualStyle" Value="{StaticResource ChromeFocus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="Track" Height="23" Width="38" CornerRadius="12" HorizontalAlignment="Left" Background="{DynamicResource ChromeTrack}" BorderBrush="{DynamicResource ChromeEdge}" BorderThickness="1"><Ellipse x:Name="Knob" Fill="White" Width="17" Height="17" HorizontalAlignment="Left" Margin="2"/></Border>
            <ContentPresenter Grid.Column="1" Margin="8,4,0,4" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid><ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource ChromeAccent}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ChromeAccent}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Knob" Property="Opacity" Value="0.65"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="CaretBrush" Value="{DynamicResource ChromeText}"/><Setter Property="Background" Value="{DynamicResource ChromePanel}"/><Setter Property="BorderBrush" Value="{DynamicResource ChromeEdge}"/><Setter Property="Padding" Value="9,6"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ChromeAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ChromeTrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Slider"><Setter Property="MinHeight" Value="30"/><Setter Property="FocusVisualStyle" Value="{StaticResource ChromeFocus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent" Margin="2,0"><Track x:Name="PART_Track" VerticalAlignment="Center"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource ChromeTrackButton}" Background="{DynamicResource ChromeAccent}"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource ChromeTrackButton}" Background="{DynamicResource ChromeTrack}"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="18" Height="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Handle" CornerRadius="9" Background="{DynamicResource ChromeControl}" BorderThickness="1.5" BorderBrush="{DynamicResource ChromeAccent}"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource ChromeHover}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource ChromePressed}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="MinHeight" Value="32"/><Setter Property="FocusVisualStyle" Value="{StaticResource ChromeFocus}"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource ChromeToggle}" HorizontalContentAlignment="Stretch"><Grid MinWidth="170"><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="2,0,20,0"/><Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource ChromeText}" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource ChromeBase}" BorderBrush="{DynamicResource ChromeEdge}" BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ChromeHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ChromeSelected}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBox"><Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="Background" Value="{DynamicResource ChromePanel}"/><Setter Property="BorderBrush" Value="{DynamicResource ChromeEdge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6"/><Setter Property="FocusVisualStyle" Value="{StaticResource ChromeFocus}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ChromeHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ChromeSelected}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ToolTip"><Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="Background" Value="{DynamicResource ChromeBase}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ChromeEdge}" BorderThickness="1" Padding="12,8" CornerRadius="10" MaxWidth="420"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>